# Neon Auth for your branch, ending in /auth (Console > Auth, or `get_auth` in the Neon MCP).
# Use the same branch as the backend's DATABASE_URL: users live in that branch's database.
VITE_NEON_AUTH_URL=
VITE_API_BASE_URL=http://localhost:8000

# Optional: shows "Try the demo" on Login. On the dev branch, the seeded demo account
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=demo-password
