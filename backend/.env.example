# Postgres on your Neon branch. Use the pooled connection string (host contains -pooler).
DATABASE_URL=
# Neon Auth for the same branch: Console > Auth, or `get_auth` in the Neon MCP. Ends in /auth.
NEON_AUTH_BASE_URL=

# Neon Object Storage for the same branch: a credential with storage:read and storage:write
# (Console > Connect > Storage). Credentials only work on their branch and its children.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
STORAGE_BUCKET=application-files

FRONTEND_URL=http://localhost:5173
