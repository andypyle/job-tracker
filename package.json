{
  "name": "job-tracker",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "storybook": "pnpm --filter frontend storybook",
    "db:migrate": "dbmate --env-file backend/.env --migrations-dir db/migrations --no-dump-schema up",
    "db:status": "dbmate --env-file backend/.env --migrations-dir db/migrations status",
    "db:new": "dbmate --migrations-dir db/migrations new"
  },
  "devDependencies": {
    "dbmate": "2.37.0",
    "supabase": "^2.122.0"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0"
  }
}
